# POC credentials. Not secrets - they exist so the demo is reproducible.
# The S3 keys MUST stay in sync with config/s3-identities.json.

SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.53

# Bind address for the one client-facing port. Use 127.0.0.1 if you do not
# want the S3 endpoint reachable from outside the VM.
S3_PUBLISH_ADDR=0.0.0.0

# --- S3 identities (mirror of config/s3-identities.json) -------------------
S3_BUCKET=poc-bucket
S3_ENDPOINT=http://s3-lb:8333

S3_ACCESS_KEY=poc-app-rw
S3_SECRET_KEY=poc-app-rw-secret-change-me

S3_RO_ACCESS_KEY=poc-app-ro
S3_RO_SECRET_KEY=poc-app-ro-secret-change-me

S3_ADMIN_ACCESS_KEY=poc-admin
S3_ADMIN_SECRET_KEY=poc-admin-secret-change-me

# --- filer metadata store --------------------------------------------------
FILER_DB_USER=seaweedfs
FILER_DB_PASSWORD=seaweedfs_poc_pw
FILER_DB_NAME=seaweedfs

# --- management UI ---------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_poc
